# Desktop client configuration. Copy to .env (git-ignored) only if you need
# values different from these local defaults. Environment variables win
# over this file. Only URLs and timeouts: never put credentials or tokens here.

BOOKS_BASE_URL=http://127.0.0.1:5000
LOGIN_BASE_URL=http://127.0.0.1:5001
USERS_BASE_URL=http://127.0.0.1:5002
AUTHORS_BASE_URL=http://127.0.0.1:5003
ORDERS_BASE_URL=http://127.0.0.1:5004
PAYMENTS_BASE_URL=http://127.0.0.1:5005

# Seconds. HTTP_TIMEOUT bounds connect and every read of a request.
HTTP_TIMEOUT_SECONDS=10
HEALTH_TIMEOUT_SECONDS=3
# Automatic refresh of the service traffic lights (plus the manual button).
HEALTH_REFRESH_SECONDS=60
