# PostgreSQL
# Example for local PostgreSQL:
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=library_db_test
PGUSER=library_soap_user
PGPASSWORD=CHANGE_ME_LOCALLY

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional. Absolute path to the directory that physically stores the book
# cover images referenced by imagenes_libro.url (e.g. a stored value of
# "/uploads/libros/foo.jpg" is served from "<this dir>/foo.jpg" via
# GET /uploads/libros/foo.jpg). When unset, defaults to
# <library_soap_service>/uploads/libros.
UPLOADS_LIBROS_DIR=

# ---------------------------------------------------------------------------
# Books security and cache (read through apps/services/shared/library_shared).
# REQUIRED: the service refuses to start without JWT_SECRET_KEY and REDIS_URL.
# Use the SAME JWT_SECRET_KEY and REDIS_URL as the login service (5001).
# Redis down at runtime: public GETs keep working from PostgreSQL; protected
# writes answer 503 (token revocation cannot be verified).
# ---------------------------------------------------------------------------
# development | production. In production CORS_ALLOWED_ORIGINS may not be '*'.
APP_ENV=development
# At least 32 chars, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_LOCALLY_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_MINUTES=20
JWT_REFRESH_TTL_DAYS=7
# redis://:<password>@<host>:6379/<db>  (rediss:// if Redis is behind TLS)
REDIS_URL=redis://:CHANGE_ME_LOCALLY@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Short TTL for books:<isbn> and books:list:<filters> (Redis is optional for
# these reads: if it fails, PostgreSQL answers directly).
BOOKS_CACHE_TTL_SECONDS=60
# Comma-separated exact origins. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
