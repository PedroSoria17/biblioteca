# Copy this file to .env and fill in real values locally. Never commit .env
# or paste real credentials into this example file.

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5004
FLASK_DEBUG=false
# development | production. In production CORS_ALLOWED_ORIGINS may not be '*'.
APP_ENV=development

# PostgreSQL - same library_db used by every service (see data/).
# library_user already has SELECT/INSERT/UPDATE/DELETE on pedidos,
# pedido_detalle, libros and usuarios (00_create_database.sql + migration 07).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=CHANGE_ME_LOCALLY

# ---------------------------------------------------------------------------
# JWT + Redis (read through apps/services/shared/library_shared).
# REQUIRED: the service refuses to start without JWT_SECRET_KEY and REDIS_URL.
# They must be the SAME values used by login (5001), books/soap (5000),
# users (5002) and authors (5003). Redis is used for JWT revocation checks
# and to drop Books' cached entries after a stock change (no own cache).
# ---------------------------------------------------------------------------
# At least 32 chars, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_LOCALLY_AT_LEAST_32_CHARACTERS
# redis://:<password>@<host>:6379/<db>  (rediss:// if Redis is behind TLS)
REDIS_URL=redis://:CHANGE_ME_LOCALLY@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Comma-separated exact origins. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
