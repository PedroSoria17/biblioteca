# Copy this file to .env and fill in real values locally. Never commit .env
# or paste real credentials into this example file.

# Flask
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
# Random long string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# Flask's own secret. Authentication no longer uses the Flask cookie session
# (it is JWT + Redis now), but the variable is still required.
SECRET_KEY=CHANGE_ME_LOCALLY

# PostgreSQL - same database already used by the rest of the project
# (see data/), not a new one. library_db / library_user match
# data/00_create_database.sql; adjust if your local setup differs.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=library_db
DB_USER=library_user
DB_PASSWORD=CHANGE_ME_LOCALLY

# Mail / Postfix (see README.md for how this maps to a local Postfix MTA
# on the GCP VM, e.g. MAIL_HOST=localhost, MAIL_PORT=25).
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_FROM=no-reply@example.com

# Used to build the link sent in the verification email:
# {PUBLIC_BASE_URL}/verify-email?token=...
PUBLIC_BASE_URL=http://34.51.88.92:5001
EMAIL_TOKEN_EXPIRATION_MINUTES=60

# Optional. When true AND MAIL_ENABLED=false, prints the verification URL
# to the console during /register so it can be tested without a working
# mail server. Never enable this in production.
DEV_SHOW_VERIFICATION_LINK=false

# Optional, legacy. No session cookie is issued anymore; kept so existing
# .env files stay valid.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# JWT + Redis authentication (read through apps/services/shared/library_shared).
# REQUIRED: the service refuses to start without JWT_SECRET_KEY and REDIS_URL.
# Every service (login, books/soap, users, authors, orders, payments) must
# receive the SAME JWT_SECRET_KEY and REDIS_URL.
# ---------------------------------------------------------------------------
# development | production. In production CORS_ALLOWED_ORIGINS may not be '*'.
APP_ENV=development
# At least 32 chars, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_LOCALLY_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_MINUTES=20
JWT_REFRESH_TTL_DAYS=7
# redis://:<password>@<host>:6379/<db>  (rediss:// if Redis is behind TLS)
REDIS_URL=redis://:CHANGE_ME_LOCALLY@127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
# Comma-separated exact origins. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
